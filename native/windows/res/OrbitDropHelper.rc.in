// Generated into the build directory by CMake (configure_file).
#include <winver.h>

#ifdef ORBITDROP_RC_EMBED_MANIFEST
// RT_MANIFEST (24), CREATEPROCESS_MANIFEST_RESOURCE_ID (1). MSVC builds merge the
// manifest through the linker instead (/MANIFESTINPUT), so it is not embedded twice.
1 24 "@ORBITDROP_MANIFEST_PATH@"
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "OrbitDrop"
            VALUE "FileDescription", "OrbitDrop drag helper"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "OrbitDropHelper"
            VALUE "OriginalFilename", "OrbitDropHelper.exe"
            VALUE "ProductName", "OrbitDrop"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
